# Cache policy for the "shell + hot update" scheme (Agent.md §13).
# Format: Cloudflare Pages / Netlify `_headers`. The release plugin copies this file to dist/.
# Rule of thumb: entry files are never cached; hashed files are immutable.

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/version.json
  Cache-Control: no-store

/version.*.json
  Cache-Control: no-store

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache

/.well-known/assetlinks.json
  Content-Type: application/json
  Cache-Control: no-cache
  Access-Control-Allow-Origin: *

/static/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=86400
